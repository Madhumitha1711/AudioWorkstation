# --- App ---
PORT=3000
# Comma-separated list of origins allowed to call this API (e.g. the
# studio-vr dev server). Leave unset to allow all origins in development.
CORS_ORIGINS=http://localhost:5173

# --- Database: Postgres via TypeORM ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=studio-db
DATABASE_SSL=false
# Only matters when DATABASE_SSL=true. Amazon RDS's cert is signed by the
# Amazon RDS CA, which Node doesn't trust by default — set this to false
# against RDS (same workaround studio-cms/.env.example uses), or leave true
# and supply the RDS CA bundle instead if you want full chain verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Auto-creates/updates tables from the entity classes on every boot — no
# migrations exist in this app yet. NOT tied to NODE_ENV (the Dockerfile
# hardcodes NODE_ENV=production for the deployed container regardless of
# environment, so gating this on NODE_ENV meant it was silently always off
# there and studio-db never got its tables). Set true for dev/staging;
# switch to real migrations and leave this false before any real user data
# exists, since synchronize can drop/alter columns to match the entities.
DATABASE_SYNCHRONIZE=false

# --- Studio CMS: Strapi ---
# Base URL of the studio-cms Strapi instance this service proxies.
STRAPI_BASE_URL=http://localhost:1337
# Server-side API token from Strapi (Settings -> API Tokens). Strapi's
# users-permissions plugin has been removed there on purpose, so every
# content-API request needs this token as `Authorization: Bearer <token>`.
# Treat it as a secret — never send it to studio-vr/the browser directly;
# that's the whole reason this proxy exists.
STRAPI_API_TOKEN=replace-with-a-real-token-from-strapi-admin-settings-api-tokens

# --- Auth: JWT session tokens ---
# Used to sign the token returned by /auth/signup, /auth/login and
# /auth/google. Generate a long random string for real deployments, e.g.
# `openssl rand -base64 48`. The fallback below is fine for local dev only.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# --- Auth: Google Sign-In ---
# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application).
# Must match VITE_GOOGLE_CLIENT_ID in studio-vr/.env. Leave unset to disable
# Google Sign-In server-side (POST /auth/google will 401).
GOOGLE_CLIENT_ID=

# --- Auth: AWS SES (forgot-password verification code emails) ---
# Leave any of these unset and the six-digit code is logged to the server
# console instead of emailed — handy for local dev without an AWS account.
# For a real deployment: verify SES_FROM_EMAIL (or its domain) in the SES
# console, and use an IAM user/role scoped to ses:SendEmail only.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# --- Course assets: presigned S3 URLs (studio-cms media, e.g. model3d
#     3D scans / images) ---
# studio-cms's Strapi uploads course assets to S3 (see studio-cms's
# config/plugins.ts + .env AWS_BUCKET) but never hands the raw S3 URL to
# the browser — CoursesService rewrites it into a short-lived presigned URL
# via AssetUrlService before /courses responds, so the bucket doesn't need
# a public-read policy. Reuses AWS_REGION/AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY above (the same IAM user needs s3:GetObject on the
# bucket below in addition to ses:SendEmail). Leave AWS_ASSETS_BUCKET unset
# to skip presigning entirely and pass studio-cms's media URLs through
# unchanged (only works if that bucket is public-read).
AWS_ASSETS_BUCKET=
# Must match studio-cms's AWS_BUCKET.
# Only needed for an S3-compatible endpoint (R2, MinIO, ...) — must match
# studio-cms's AWS_ENDPOINT / AWS_FORCE_PATH_STYLE.
AWS_ASSETS_ENDPOINT=
AWS_ASSETS_FORCE_PATH_STYLE=false
# How long a presigned asset URL stays valid, in seconds. Defaults to 3600
# (1 hour) if unset.
AWS_ASSET_URL_EXPIRES_IN=3600

# --- Course videos: signed Cloudflare Stream playback tokens ---
# studio-cms uploads course videos to Cloudflare Stream with
# requireSignedURLs enabled (see studio-cms's uploadVideoToCloudflareStream),
# so the plain https://iframe.cloudflarestream.com/<videoUid> URL no longer
# plays anything back. CoursesService rewrites the raw videoUid into a
# short-lived signed token via CloudflareStreamTokenService before /courses
# responds — that's the ONLY thing that makes a course video playable, so
# without these two vars set, every paid video is effectively unreachable
# (leave both unset only for local dev against videos that predate this
# flag; see studio-cms's scripts/secure-existing-videos.mjs to migrate
# those too).
#
# Easiest path: from studio-cms/, run `npm run create:stream-key` (see
# scripts/create-stream-signing-key.mjs) — it creates the key via
# Cloudflare's API and writes both vars below into this file for you,
# handling the base64-decoding gotcha described next.
#
# To do it by hand instead: create a signing key once via Cloudflare's API
# (there's no dashboard UI for this yet):
#   curl -X POST \
#     https://api.cloudflare.com/client/v4/accounts/<CLOUDFLARE_ACCOUNT_ID>/stream/keys \
#     -H "Authorization: Bearer <CLOUDFLARE_STREAM_API_TOKEN>"
# The response's `result.id` is CLOUDFLARE_STREAM_KEY_ID as-is. `result.pem`
# is NOT the raw PEM text — Cloudflare returns it base64-encoded, so it must
# be base64-decoded first (e.g. `Buffer.from(result.pem, 'base64').toString('utf8')`
# in Node, or `echo "$PEM" | base64 -d` in a shell) to get the real
# "-----BEGIN RSA PRIVATE KEY-----...-----END RSA PRIVATE KEY-----" text.
# Using result.pem directly (skipping the decode) produces a value that
# LOOKS like a plausible secret but isn't valid PEM, and fails at runtime
# with jsonwebtoken's "secretOrPrivateKey must be an asymmetric key when
# using RS256" — easy mistake, and the error only shows up when a video is
# actually requested, not at startup.
# Only once decoded, replace its real newlines with literal "\n" so it
# stays a single env-var line, e.g.:
#   CLOUDFLARE_STREAM_SIGNING_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIev...\n-----END RSA PRIVATE KEY-----\n"
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY=
# How long a signed playback token stays valid, in seconds. Defaults to
# 14400 (4 hours) if unset.
CLOUDFLARE_STREAM_TOKEN_EXPIRES_IN=14400

# --- Auth: admin accounts ---
# Comma-separated list of emails that get promoted to role='admin' the
# next time that account signs up/logs in/uses Google sign-in (see
# AuthService.syncAdminRole). Admin accounts skip the payment gate
# entirely — see User.hasAccess and JwtAuthGuard. Promote-only: removing
# an email here later does NOT revoke admin from an account that already
# has it; that would need a direct database update.
ADMIN_EMAILS=

# --- Payments: full-course lifetime access, one-time purchase ---
# Every authenticated API route requires the signed-in user to have
# access (see JwtAuthGuard: User.hasAccess = hasPaid OR role==='admin')
# except the handful of routes marked @SkipPayment() — GET /auth/me and
# the /payments/* endpoints themselves. There is no way to reach
# /course, /studio content, etc. without this being satisfied.
#
# Price charged server-side (PaymentsService) — keep in sync with
# studio-vr/src/store/checkoutSlice.js's PRICE if you change it.
COURSE_PRICE_USD=199

# Which gateway is active for *new* orders. Both integrations are always
# available in the backend (see PaymentGatewayRegistry) — flipping this is
# a redeploy, not a code change. Valid values: razorpay | stripe
PAYMENT_GATEWAY=razorpay

# Base URL of the studio-vr frontend. Only used by the Stripe integration,
# to build the Checkout success/cancel redirect URLs — Razorpay's modal
# checkout never navigates away from the page so it doesn't need this.
FRONTEND_URL=http://localhost:5173

# --- Payments: Razorpay ---
# From the Razorpay dashboard: Settings -> API Keys for the first two,
# Settings -> Webhooks (add an endpoint pointing at
# <this API>/payments/webhook/razorpay, subscribed to at least
# payment.captured and payment.failed) for the webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: Stripe ---
# From the Stripe dashboard: Developers -> API Keys for the secret key,
# Developers -> Webhooks (add an endpoint pointing at
# <this API>/payments/webhook/stripe, subscribed to at least
# checkout.session.completed) for the webhook signing secret. No
# publishable key is needed — the frontend never talks to Stripe directly,
# it's redirected to a Stripe-hosted Checkout page instead (see
# StripeGateway).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
